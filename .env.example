# SafeStay env — copy to .env.local. All keys stay server-side; never commit real values.

# Private key (0x-prefixed hex) of a funded Tiramisu wallet used to seed demo data.
# Faucet: https://hub.arkiv.network/faucet   (select Tiramisu)
ARKIV_SEED_KEY=

# Server-side signer keys for demo-mode writes (tenant + landlord seeded wallets).
# Without these the Record page cannot sign; public lookup still reads live data.
ARKIV_TENANT_KEY=
ARKIV_LANDLORD_KEY=

# OPTIONAL — Arkiv RPC access key (X-API-KEY header) for a higher query budget.
# Public reads work without it; set it if you hit ANON_COST_LIMITED on the
# anonymous quota. Get one at https://hub.arkiv.network — server env only.
ARKIV_API_KEY=
